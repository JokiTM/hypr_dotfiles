#!/usr/bin/env bash

NOW=$(date +"%Y-%m-%d_%H-%M-%S")
FILEPATH="$HOME/Pictures/Screenshots/$NOW.png"

if [ "$1" = "fullscreen" ]; then
    grim - | tee "$FILEPATH" | wl-copy
else 
    slurp 2> /dev/null | grim -g - "$FILEPATH"  > /dev/null 2>&1 
    if [ -s $FILEPATH ]; then
        cat "$FILEPATH" | wl-copy 
    fi
fi
