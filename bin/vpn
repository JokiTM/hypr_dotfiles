#!/usr/bin/env bash

ip link show | grep $2 2>&1 1>/dev/null

isactive=$?

if [ $1 == "toggle" ]; then
    if [ $isactive = 1 ]; then
        nmcli connection up $2 > /dev/null
    else
        nmcli connection down $2 > /dev/null
    fi
elif [ $1 == "status" ]; then
    if [ $isactive == 1 ]; then
        if [ $2 == "heimnetz" ]; then
            echo 󱩇
        else
            echo 󰦜
        fi
    else
        if [ $2 == "heimnetz" ]; then
            echo 󰳋
        else
            echo 󰒙
        fi
    fi
fi
