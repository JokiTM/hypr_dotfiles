{
    "include": "~/.config/waybar/hw-modules.json",
    "hyprland/workspaces": {
        "show-special": true,
        "all-outputs": false,
        "special-visible-only": true,
        "format": "{icon}", 
        "format-icons": {
            "piracy": "󰠳",
            "obs": "",
            "thunderbird": "",
            "music": "󰎇",
            "scrap": "󰫢",
            "sysmon": "",
            "whatsapp": "󰖣"
        },
        "on-scroll-down": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"e+1\" }))'",
        "on-scroll-up": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"e-1\" }))'"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "timezone": "Europe/Berlin",
        //"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        //"format-alt": " {:%d/%m/%Y}",
        //"format": " {:%H:%M}"
        "tooltip-format": "<tt>{calendar}</tt>",
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰥔 {:%H:%M:%S}",
        "calendar": {
        //    "mode": "month",
        //    "mode-mon-col": 3,
        //    "weeks-pos": "left",
        //    "on-scroll": 1,
            "format": {
        //        "months": "<span color='#ffead3'><b>{}</b></span>",
        //        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        //        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        //        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
    },
    "pulseaudio": {
        "scroll-step": 2,
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pkill wiremix || foot -T wiremix zsh -c '~/.config/hypr/scripts/dispatch.sh wiremix'",
        "on-click-right": "~/.config/waybar/scripts/toggleAudioDevice.sh"
    },
    "custom/lock": {
        "tooltip": false,
        "on-click": "loginctl lock-session",
        "format": ""
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "loginctl shutdown",
            "reboot": "loginctl reboot",
            "suspend": "loginctl suspend",
            "hibernate": "loginctl hibernate",
        },
    },
    "custom/soypower": {
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/hibernate.sh",
        "on-click-right": "wlogout &",
        "format": "⏻"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "mpris#long": {
        "player": "mpd",
        "format": "<i>{dynamic}</i>",
        "dynamic-order": ["title", "{dynamic-seperator}", "artist"],
        "on-click": "~/.config/waybar/scripts/media.sh",
        "on-click-right": "playerctl play-pause",
        "on-scroll-up": "playerctl -p mpd volume .05+",
        "on-scroll-down": "playerctl -p mpd volume .05-",
    },
    "mpris#short": {
        //"format": "{player_icon} {dynamic}",
        "format": "<i>{title}</i>",
        "player": "mpd",
        "max-length": 60,
        "player-icons": {
            "default": "▶",
            "mpv": "🎵"
        },
        "status-icons": {
            "playing": "",
            "paused": ""
        },
        "on-click": "~/.config/waybar/scripts/media.sh",
        "on-click-right": "playerctl play-pause",
        "on-scroll-up": "playerctl -p mpd volume .05+",
        "on-scroll-down": "playerctl -p mpd volume .05-",
        // "ignored-players": ["firefox"]
    },
    "mpris#icon": {
        //"format": "{player_icon} {dynamic}",
        "format": "{status_icon}",
        "max-length": 60,
        "player-icons": {
            "default": "▶",
            "mpv": "🎵"
        },
        "status-icons": {
            "playing": "",
            "paused": ""
        },
        "on-click": "~/.config/waybar/scripts/media.sh",
        "on-click-right": "playerctl play-pause",
        "on-scroll-up": "playerctl -p mpd volume .05+",
        "on-scroll-down": "playerctl -p mpd volume .05-",
        // "ignored-players": ["firefox"]
    },
    "image": {
        "exec": "ls ~/.cache/rmpcd/albumart/*",
        "size": 24,
        "interval": 1,
        "on-click":  "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"music\")'",
        "on-click-right": "~/.config/waybar/scripts/viewcover.sh",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "battery": {
    "interval": 60,
    "format": "{capacity}% {icon}",
    "format-icons": {
        "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    }
    },
    "network": {
        "format": "󰖪",
        "interface": "wlan0",
        "on-click": "pkill nmtui-connect || foot -T 'nmtui-connect' zsh -c '~/.config/hypr/scripts/dispatch.sh 'nmtui-connect''",
        "interval": 5,
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "󰖪", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "󱚶 {bandwidthDownBits} | 󱚺 {bandwidthUpBits}",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
    }
}
